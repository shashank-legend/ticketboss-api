{
  "name": "ticketboss-api",
  "version": "1.0.0",
  "description": "Event ticketing app with a web UI and optimistic concurrency control",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node src/db/init.js",
    "test": "NODE_ENV=test jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "NODE_ENV=test jest --runInBand --watch",
    "test:coverage": "NODE_ENV=test jest --runInBand --coverage --forceExit"
  },
  "keywords": [
    "ticketing",
    "concurrency",
    "nodejs",
    "express",
    "postgresql"
  ],
  "author": "shashank-legend",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "joi": "^17.11.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testTimeout": 30000
  },
  "engines": {
    "node": ">=18"
  }
}
